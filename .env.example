# Copy to .env.local for development. Railway holds the production values.

# === Required (production start fails without these, see src/lib/server/env.ts) ===
# Helius RPC with your key. Ships to browsers, so restrict the key to your domain in the Helius dashboard.
NEXT_PUBLIC_SOLANA_RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=
BIRDEYE_API_KEY=
# Wallet that can sign in to /admin.
NEXT_PUBLIC_ADMIN_PUBKEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
# Signs Elite and admin sessions. Use a long random string, for example `openssl rand -base64 48`.
VORTEX_JWT_SECRET=

# === App ===
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_URL=https://web-production-d0455.up.railway.app
# devnet for local payment tests; anything else means mainnet-beta.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# === Optional ===
# CoinGecko paid on-chain API key. Without it, market lists use GeckoTerminal's free tier (about 30 requests a minute).
COINGECKO_API_KEY=
# Jupiter API key for higher price and quote limits. Keyless works.
JUPITER_API_KEY=
# Discord or Slack incoming webhook for payment and error alerts.
ALERT_WEBHOOK_URL=
# Support link shown on the Terms and Privacy pages (an X profile, Telegram group or email link).
NEXT_PUBLIC_SUPPORT_URL=
# Elite trial access codes, comma-separated. Empty disables code redemption.
ELITE_ACCESS_CODES=
# Optional Elite pass NFT collection mint. Empty disables the NFT check.
NEXT_PUBLIC_ELITE_NFT_COLLECTION=
# Aether indexer GraphQL URL. Parked; leave empty.
NEXT_PUBLIC_AETHER_API_URL=
