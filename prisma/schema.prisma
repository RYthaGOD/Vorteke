generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
}

model Token {
    address         String   @id
    name            String
    symbol          String
    logoURI         String?
    priceUsd        Float    @default(0)
    priceChange24h  Float    @default(0)
    volume24h       Float    @default(0)
    liquidityUsd    Float    @default(0)
    fdv             Float    @default(0)
    mcap            Float    @default(0)
    tier            String   @default("Basic")
    securityTags    String?
    advancedMetrics String?
    creator         String?
    lastUpdated     DateTime @default(now())

    @@index([creator])
}

model Enhancement {
    address           String    @id
    tier              String    @default("Basic") // Basic | Enhanced
    owner             String?
    socials           String?
    customDescription String?
    bannerURI         String?
    iconURI           String?
    lastPaymentTx     String?   @unique
    lastPaymentTime   DateTime?
    boostExpiresAt    DateTime? // Promoted placement runs until this time

    @@index([lastPaymentTx])
    @@index([boostExpiresAt])
}

model Claim {
    id        String   @id @default(uuid())
    address   String
    wallet    String
    signature String
    timestamp DateTime
    createdAt DateTime @default(now())

    @@unique([address, wallet])
}

model EliteAccess {
    wallet    String   @id
    expiresAt DateTime
    source    String   @default("grant") // paid | grant | code
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([expiresAt])
}

// No longer written: DeepScan became a free scan in October 2026. Kept so past records survive.
model DeepScanRecord {
    signature String   @id
    address   String
    wallet    String
    createdAt DateTime @default(now())
}

model ApiKey {
    key                String   @id @default(uuid())
    email              String
    tier               String   @default("free") // free | starter | pro | enterprise
    requestsThisPeriod Int      @default(0)
    periodStart        DateTime @default(now())
    revoked            Boolean  @default(false)
    createdAt          DateTime @default(now())
    lastUsedAt          DateTime?

    @@index([email])
}

model PaymentIntent {
    id String @id @default(uuid())
    wallet String
    address String
    tier String // product: Enhanced | Boost | EliteAccess
    lamports Int
    usdCents Int? // price in USD cents the lamports were quoted from
    createdAt DateTime @default(now())
    expiresAt DateTime
    receipt PaymentReceipt?
}

model PaymentReceipt {
    signature String @id
    intentId String @unique
    intent PaymentIntent @relation(fields: [intentId], references: [id])
    createdAt DateTime @default(now())
}

// Daily counts of the five project-funnel steps, written by /api/event. No user data.
model FunnelEvent {
    day   String // UTC date, YYYY-MM-DD
    name  String
    count Int    @default(0)

    @@id([day, name])
}
